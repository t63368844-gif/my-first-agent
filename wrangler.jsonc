{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-first-agent",
	"main": "src/server.ts",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/download/*",
			"/agents/*",
			"/oauth/*",
			"/download"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatAgent",
				"name": "ChatAgent"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"ChatAgent"
			],
			"tag": "v1"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		"crons": []
	},
	"kv_namespaces": [
		{
			"binding": "PDF_STORE",
			"id": "59e4399ea788458bafcacaed0819a0e5"
		},
		{
			"binding": "SKILLS",
			"id": "f8d38a5221064201b561900733ac9ca3",
			"remote": true
		}
	]
}